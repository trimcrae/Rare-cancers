# Local literature cache (raw full text is an intermediate artifact; the
# structured, cited data we keep lives in data/cancers/*.json instead).
.cache/

# Test tooling (if ever added locally)
node_modules/

# Python bytecode
__pycache__/
*.pyc
boltz_out/
cofold_out/

# Claude Code agent worktrees (transient, per-session)
.claude/worktrees/

# ...AND worktrees an agent checks out INTO THE REPO ROOT (`git worktree add wt-<name>`), which several have.
# The right home is the session scratchpad, but the wrong home must not be a data-loss trap: the directory is
# a full checkout of the repo, so a lane running `git add -A` would commit the entire tree into itself, and
# `git clean` would delete a live agent's in-progress work. Ignoring it makes both mistakes impossible while
# `git worktree list` still shows it and `git worktree remove` still cleans it up properly.
wt-*/

# RCSB coordinate cache for the E3 recruiter staging (re-downloadable; not an artifact)
research/modalities/_e3_recruiter_coords/

# Lane-session polling helpers (transient tooling, not a deliverable)
scratchpad-lane1/

# The basin search's SYNTHETIC self-test output. It shares a schema with the production artifact and used to
# share its filename too, which let a local `--self-test` overwrite the committed 12-pose result (2026-07-25).
research/modalities/nr4a3-orientation-basins-selftest.json

# LANE 10 scratch (transient tooling and logs, not deliverables)
scratchpad/lane10-*

# The ledger's atomic-write scratch. `ternary_launch_ledger._write` writes here then `os.replace`s onto the
# real file, so one only survives a SIGKILL mid-write — and a lane running `git add -A` would then commit a
# half-written ledger under a name that looks deliberate.
research/modalities/.ledger-*.tmp

# Local git worktree used to port commits to main without switching branches in the primary
# checkout. It is a working directory, never repo content — committing it would nest a checkout.
mainwt2/
