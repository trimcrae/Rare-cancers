st": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1530/JME-13-0212"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC3845022"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC3845022?pdf=render"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1530/jme-13-0212"}]}, "isOpenAccess": "N", "inEPMC": "Y", "inPMC": "Y", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "N", "citedByCount": 71, "hasData": "Y", "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasLabsLinks": "N", "hasEvaluations": "N", "authMan": "Y", "epmcAuthMan": "N", "nihAuthMan": "Y", "manuscriptId": "NIHMS529601", "hasTMAccessionNumbers": "Y", "tmAccessionTypeList": {"accessionType": ["doi"]}, "dateOfCompletion": "2014-07-29", "dateOfCreation": "2013-10-08", "firstIndexDate": "2013-10-08", "fullTextReceivedDate": "2025-02-05", "dateOfRevision": "2021-10-21", "electronicPublicationDate": "2013-11-26", "firstPublicationDate": "2013-11-26"}, {"id": "21205929", "source": "MED", "pmid": "21205929", "pmcid": "PMC3062356", "fullTextIdList": {"fullTextId": ["PMC3062356"]}, "doi": "10.1182/blood-2010-02-267906", "title": "Reduced NR4A gene dosage leads to mixed myelodysplastic/myeloproliferative neoplasms in mice.", "authorString": "Ramirez-Herrick AM, Mullican SE, Sheehan AM, Conneely OM.", "authorList": {"author": [{"fullName": "Ramirez-Herrick AM", "firstName": "Ashley M", "lastName": "Ramirez-Herrick", "initials": "AM", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Molecular and Cellular Biology, Baylor College of Medicine, Houston, TX 77030, USA."}]}}, {"fullName": "Mullican SE", "firstName": "Shannon E", "lastName": "Mullican", "initials": "SE"}, {"fullName": "Sheehan AM", "firstName": "Andrea M", "lastName": "Sheehan", "initials": "AM"}, {"fullName": "Conneely OM", "firstName": "Orla M", "lastName": "Conneely", "initials": "OM"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data", "related_data"]}, "journalInfo": {"issue": "9", "volume": "117", "journalIssueId": 1812996, "dateOfPublication": "2011 Mar", "monthOfPublication": 3, "yearOfPublication": 2011, "printPublicationDate": "2011-03-01", "journal": {"title": "Blood", "medlineAbbreviation": "Blood", "isoabbreviation": "Blood", "nlmid": "7603509", "issn": "0006-4971", "essn": "1528-0020"}}, "pubYear": "2011", "pageInfo": "2681-2690", "abstractText": "The NR4A subfamily of nuclear receptors (NR4A1, NR4A2, and NR4A3) function as transcription factors that transduce diverse extracellular signals into altered gene transcription to coordinate apoptosis, proliferation, cell cycle arrest, and DNA repair. We previously discovered that 2 of these receptors, NR4A1 and NR4A3, are potent tumor suppressors of acute myeloid leukemia (AML); they are silenced in human AML, and abrogation of both genes in mice leads to rapid postnatal development of AML. Reduced expression of NR4As is also a common feature of myelodysplastic syndromes (MDSs). Here we show that reduced gene dosage of NR4A1 and NR4A3 in hypoallelic (NR4A1(+/-)NR4A3(-/-) or NR4A1(-/-)NR4A3(+/-)) mice below a critical threshold leads to a chronic myeloid malignancy that closely recapitulates the pathologic features of mixed myelodysplastic/myeloproliferative neoplasms (MDS/MPNs) with progression to AML in rare cases. Enhanced proliferation and excessive apoptosis of hematopoietic stem cells and myeloid progenitors, together with elevated DNA damage, contribute to MDS/MPN disease. We identify the myeloid tumor suppressor genes Egr1 and JunB and the DNA damage checkpoint kinase, polo-like kinase 2 (Plk2) as deregulated genes whose disrupted signaling probably contributes to MDS/MPN. These mice provide a novel model to elucidate the molecular pathogenesis of MDS/MPN and for therapeutic evaluation.", "affiliation": "Department of Molecular and Cellular Biology, Baylor College of Medicine, Houston, TX 77030, USA.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["research-article", "Research Support, U.S. Gov't, Non-P.H.S.", "Journal Article", "Research Support, N.I.H., Extramural"]}, "grantsList": {"grant": [{"grantId": "R01 CA111411", "agency": "NCI NIH HHS", "acronym": "CA", "orderIn": 0}, {"grantId": "R01CA111411", "agency": "NCI NIH HHS", "acronym": "CA", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Myeloid Progenitor Cells", "meshQualifierList": {"meshQualifier": [{"abbreviation": "PA", "qualifierName": "pathology", "majorTopic_YN": "N"}]}}, {"majorTopic_YN": "N", "descriptorName": "Animals"}, {"majorTopic_YN": "N", "descriptorName": "Mice, Inbred C57BL"}, {"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Mice"}, {"majorTopic_YN": "N", "descriptorName": "Cell Transformation, Neoplastic", "meshQualifierList": {"meshQualifier": [{"abbreviation": "GE", "qualifierName": "genetics", "majorTopic_YN": "N"}, {"abbreviation": "PA", "qualifierName": "pathology", "majorTopic_YN": "N"}]}}, {"majorTopic_YN": "N", "descriptorName": "Myelodysplastic Syndromes", "meshQualifierList": {"meshQualifier": [{"abbreviation": "GE", "qualifierName": "genetics", "majorTopic_YN": "Y"}, {"abbreviation": "PA", "qualifierName": "pathology", "majorTopic_YN": "N"}]}}, {"majorTopic_YN": "N", "descriptorName": "Myeloproliferative Disorders", "meshQualifierList": {"meshQualifier": [{"abbreviation": "GE", "qualifierName": "genetics", "majorTopic_YN": "Y"}, {"abbreviation": "PA", "qualifierName": "pathology", "majorT