!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX11379570
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM5429nnn/GSM5429861/suppl/GSM5429861_20200813_HJZ057_RNA_1765_shDDIT3_D14_rep1.ReadsPerGene.out.tab.gz
!Sample_supplementary_file_2 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM5429nnn/GSM5429861/suppl/GSM5429861_20200813_HJZ057_RNA_1765_shDDIT3_D14_rep1_S14_R1_001.bw
