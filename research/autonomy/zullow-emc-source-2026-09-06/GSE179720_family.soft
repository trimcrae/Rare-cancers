!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX11379596
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM5429nnn/GSM5429887/suppl/GSM5429887_20210309_HJZCR094_CandR_hTERT_MSC_CMP12_StemProAdipogenesis_24hr_BRG1_S9_aligned_reads.sorted.bw
