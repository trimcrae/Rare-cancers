!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM5429nnn/GSM5429801/suppl/GSM5429801_20180926_HJZ008_ChIP_DDIT3_MLS1765_shSCR_0706_S3_R1_001.bw
