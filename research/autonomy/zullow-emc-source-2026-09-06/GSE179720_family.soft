!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX11379565
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM5429nnn/GSM5429856/suppl/GSM5429856_20210322_HJZ099_RNA_AD_MSC_CMP12_base_techrep1.ReadsPerGene.out.tab.gz
