!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX11379580
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM5429nnn/GSM5429871/suppl/GSM5429871_20190408_MLPS015_RNA_primary_644582-2.ReadsPerGene.out.tab.gz
!Sample_series_id = GSE179720
