!Sample_supplementary_file_2 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM5429nnn/GSM5429864/suppl/GSM5429864_20200813_HJZ052_RNA_402_shSCR_D7_S9_R1_001.bw
