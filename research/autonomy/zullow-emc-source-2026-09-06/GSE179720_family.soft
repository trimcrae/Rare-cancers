!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX11379533
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM5429nnn/GSM5429824/suppl/GSM5429824_20181015_HJZ012_ATAC_MLS1765_shSCR_0706.bw
!Sample_series_id = GSE179720
