!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX11379520
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM5429nnn/GSM5429811/suppl/GSM5429811_20190311_HJZ021_ChIP155_MLS1765_shDDIT3_0208_S10_R1_001.bw
