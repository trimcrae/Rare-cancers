!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX11379609
!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM5429nnn/GSM5429900/suppl/GSM5429900_20210309_HJZCR107_CandR_AD_MSC_CMP12_StemProAdipogenesis_24hr_CEBPB_S21_aligned_reads.sorted.bw
!Sample_series_id = GSE179720
