  "quantitative_observations": [
    {
      "id": "Q1",
      "claim": "Within one fusion oncoprotein, only a small minority of MS-identified HLA ligands actually span the junction.",
      "value": "DNAJB1-PRKACA: 20 unique class I ligands identified across three engineered HCC lines, of which 2 span the fusion region (10%); 13 unique class II peptides, of which 1 spans (7.7%).",
      "pmid": "36302754",
      "doi": "10.1038/s41467-022-33746-3"
    },
    {
      "id": "Q2",
      "claim": "A junction can create the HLA anchor, so junction-spanning epitopes need not have a wild-type analogue at all.",
      "value": "The wild-type counterparts of EIFDRYGEEV and IFDRYGEEV end in glycine (EIFDRYGEEG / IFDRYGEEG) and are predicted not to be presented on any allotype.",
      "pmid": "36302754",
      "doi": "10.1038/s41467-022-33746-3"
    },
    {
      "id": "Q3",
      "claim": "Junction reactivity can be register-specific to a single length.",
      "value": "For MYB::NFIB, the 9-mer QFIDSSWYL stimulated T cells while the 8-mer FIDSSWYL and 10-mer LQFIDSSWYL did not.",
      "pmid": "31011208",
      "doi": "10.1038/s41591-019-0434-2"
    },
    {
      "id": "Q4",
      "claim": "Early attempts to demonstrate natural presentation of a recurrent fusion neoantigen failed, and the 2025 success used engineered overexpression.",
      "value": "The GF-NEO platform paper states that 'early efforts to demonstrate neoantigen presentation of the recurrent GF ETV6-RUNX1 were unsuccessful', and its own MS validation was performed in JY cells transduced with an ETV6-RUNX1 minigene, not in patient leukaemia.",
      "pmid": "41567246",
      "doi": "10.1016/j.isci.2025.114512"
    },
    {
      "id": "Q5",
      "claim": "Junction peptides of the best-studied fusion bind class I poorly.",
      "value": "Of 162 p210 BCR-ABL peptides screened, only 6 of the 14 junction peptides bound any of 8 class I allotypes, and then only moderately; 48 non-junction peptides bound with intermediate or strong affinity, and CTL lines were raised only against non-junction peptides.",
      "pmid": "9295046",
      "doi": "10.1002/eji.1830270834"
    },
    {
      "id": "Q6",
      "claim": "A clinical vaccine against a validated junction epitope produced no robust immune response.",
      "value": "In the SYT-SSX breakpoint peptide phase II (n=21), delayed-type hypersensitivity was negative in all patients; an independent evaluation concluded 'No robust evidence of immune response to the target epitope was detected.'",
      "pmid": "22726592; 23252384",
      "doi": "10.1111/j.1349-7006.2012.02370.x; 10.1586/erv.12.122"
    },
    {
      "id": "Q7",
      "claim": "Vaccination against class I junction peptides can fail even when the class II response succeeds.",
      "value": "In the vaccinated FL-HCC patient, no CD8 T-cell response was observed against any of the three DNAJB1-PRKACA class I vaccine peptides; the durable response was CD4/class II.",
      "pmid": "36302754",
      "doi": "10.1038/s41467-022-33746-3"
    }
  ]
}