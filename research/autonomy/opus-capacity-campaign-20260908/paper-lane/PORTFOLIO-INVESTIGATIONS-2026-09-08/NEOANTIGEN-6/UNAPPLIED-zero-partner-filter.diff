+def partner_residue_split(fusion_prot, j0, lengths, novel_residue=False):
+    """Residues each PARENT contributes to every junction peptide, over the same enumeration
+    `junction_peptides` uses. ONE definition of the peptide set, two readings of it (rule 1).
+
+    ⚠ WHY THIS EXISTS. "Novel" in this module means *contains the seam and occurs in neither
+    canonical parent*. That admits peptides drawing NO residue at all from one parent: the whole
+    peptide is the other parent's wild-type sequence plus the single hybrid seam residue. Measured
+    on the committed panel, 8 of the 174 peptides take zero residues from EWSR1 and 20 take zero
+    from NR4A3; 2 of the 11 ranked binders are zero-EWSR1, including the RANK-1 binder `DMPCVQAQY`,
+    which `junction-proteome-novelty.json` records verbatim at residue 11 of NR4A3 isoform Q92570-3.
+    Such a peptide is not junction-specific, so a screen should not rank it as a fusion neoantigen.
+
+    ⛔ THIS IS A SCREEN-CONFIGURATION READING AND NOTHING ELSE. It is not a statement about
+    presentation, immunogenicity, tolerance, safety, selectivity or clinical usability of any
+    peptide, retained or removed. A filtered prediction is still a prediction.
+
+    A peptide emitted at more than one offset keeps its MOST junction-specific placement, so the
+    discriminator can only ever drop a peptide that is zero-partner at EVERY placement.
+    """
+    best = {}
+    for L in lengths:
+        for start in range(max(0, j0 - L + 1), j0 + 1):
+            pep = fusion_prot[start:start + L]
+            if len(pep) != L:
+                continue
+            if not novel_residue and not (start < j0 < start + L):
+                continue                                   # classic straddle, same as above
+            n_seam = 1 if novel_residue else 0
+            n5 = j0 - start                                # residues 5' of the seam: the donor's
+            n3 = start + L - j0 - n_seam                   # residues 3' of the seam: the acceptor's
+            zero = None
+            if n5 == 0 and n3 == 0:
+                zero = "zero_from_both_partners"
+            elif n5 == 0:
+                zero = "zero_from_5p_partner"
+            elif n3 == 0:
+                zero = "zero_from_3p_partner"
+            row = {"n_from_5p_partner": n5, "n_seam_hybrid": n_seam,
+                   "n_from_3p_partner": n3, "zero_partner": zero}
+            prev = best.get(pep)
+            if prev is None or (prev["zero_partner"] and not zero):
+                best[pep] = row
+    return best
+
