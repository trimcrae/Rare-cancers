+    def _dispersion(v, prefix):
+        """Dispersion + five-number summary for one arm, retained alongside the fraction.
+
+        ⭐ WHY THIS IS RETAINED (added 2026-09-09). Without it this artifact supports the dependent
+        fraction at EXACTLY ONE threshold — the -0.5 cut hard-coded above — and no interval on any
+        recorded quantity. The fraction at any other cut is a functional of a per-line distribution
+        that `stats()` previously discarded, so a reader who wants to know whether a route decision
+        survives a stricter or looser cut has to re-fetch the whole CRISPRGeneEffect matrix. Two
+        route arguments in this repository rest on that unavailable quantity: "MCL1 and BCL2L1 are
+        dependencies in the large majority of sarcoma lines" (biomarker paper) and the BRD9 synovial
+        self-validation failure, whose value away from -0.5 is not computable from what was kept.
+        The five-number summary pins P(X < t) exactly at four interior points and to within 0.25
+        elsewhere, which is enough to answer those questions offline.
+
+        `n_dependent_*` is retained for the same reason `nr4a_paralogue_comparison` already retains
+        it: the fractions here are rounded to 3 dp, so a count back-computed from a rounded fraction
+        is not exact, and the REST arm's denominator is not recorded anywhere in the output at all.
+
+        Note `pandas.Series.std()` is the SAMPLE sd (ddof=1). Nothing above is changed: every field
+        this function emitted before is emitted with the same name, the same definition and the same
+        rounding, so previously published values are unaffected by this addition.
+        """
+        return {
+            f"{prefix}_sd": round(float(v.std()), 3),
+            f"{prefix}_min": round(float(v.min()), 3),
+            f"{prefix}_q25": round(float(v.quantile(0.25)), 3),
+            f"{prefix}_median": round(float(v.median()), 3),
+            f"{prefix}_q75": round(float(v.quantile(0.75)), 3),
+            f"{prefix}_max": round(float(v.max()), 3),
+            f"n_dependent_{prefix}": int((v < DEPENDENT_THRESHOLD).sum()),
+        }
+
