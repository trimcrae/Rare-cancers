  "selected_method_blocks": [
    {
      "section": "Clinical and pathologic characteristics of the study cohort",
      "method_only_text": [
        "From 101 patients with STS (51 UPS, 25 high-grade LMS, and 26 DDLPS), 102 FFPE tumor samples were studied (Table 1). One patient contributed with two independent samples. The cohort included mostly primary high-grade STS from diverse anatomic sites, representing the topographical heterogeneity of high-grade STS."
      ]
    },
    {
