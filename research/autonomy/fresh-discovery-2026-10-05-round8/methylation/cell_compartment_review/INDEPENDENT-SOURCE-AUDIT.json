          "source": "doublet_rate = 0.11\npat_list <- c('Sarcoma167GEX', 'Sarcoma322GEX', 'Sarcoma559GEX',\n              'Sarcoma708GEX', 'SarcomaS408GEX', 'SarcomaS410GEX', \n              'SarcomaS914GEX', 'SarcomaS956GEX' ,'gs001_sarc_scseq', 'gs002_sarc_scseq')\n\nobject.list <- lapply(pat_list, function (x) readRDS(paste0('data/', x, '/data_', x, '_cb_raw.rds')))\n                      "
        },
        {
          "cell": 10,
          "cell_type": "code",
          "source": "seu_filtered.list <- lapply(X = object.list, FUN = function(x) {\n    \n    pat <- Project(x)\n    if (pat != 'gs001_sarc_scseq'& pat != 'gs002_sarc_scseq'){\n        x@meta.data$sample_type = \"frozen\"\n    }\n    else {\n        x@meta.data$sample_type = \"fresh\"\n    }\n    print(pat)\n\n    doublets <- read.table(paste0('data/', pat, '/doublets_', pat, '_raw.txt'), header = T)\n    x@meta.data$predicted_doublets  <- doublets$predicted_doublets\n    x@meta.data$doublet_scores <- doublets$doublet_scores\n\n    # remove intermediate files\n#     system(paste0('rm data/', pat, '/matrix_', pat, '_raw.mtx'))\n#     system(paste0('rm data/', pat, '/doublets_', pat, '_raw.txt'))\n\n    # Subset:\n    #   1. unique genes: between 200 and 7500\n    #   2. gene counts: between 400 and 40000\n    #   3. mitochondrial genes: < 10%\n    #   4. no doublets\n    minFeature <- 300\n    maxFeature <- 7500\n    minCount <- 600\n    maxCount <- 40000\n    maxMT <- 10\n    #x <- subset(x, subset = nFeature_RNA > minFeature & nFeature_RNA < maxFeature & nCount_RNA > minCount &\n                #nCount_RNA < maxCount & percent.mt < maxMT & predicted_doublets == F)\n    \n \n})"
        },
        {
          "cell": 33,
          "cell_type": "code",
          "source": "names <- c('Sarc\\n167', 'Sarc\\n322', 'Sarc\\n559',\n              'Sarc\\n708', 'Sarc\\nS408','Sarc\\nS410', \n              'Sarc\\nS914', 'Sarc\\nS956' ,'GS001', 'GS002')\n\npats <- c('Sarcoma167GEX', 'Sarcoma322GEX', 'Sarcoma559GEX',\n              'Sarcoma708GEX', 'SarcomaS408GEX', 'SarcomaS410GEX', \n              'SarcomaS914GEX', 'SarcomaS956GEX' ,'gs001_sarc_scseq', 'gs002_sarc_scseq') \nidkey <- data.frame(\"orig\" =  pats, \"new\" = names)\n\n\nfilt.combined@meta.data$samp.ident.recode <- dplyr::recode(\n  filt.combined$orig.ident,\n  !!!setNames(as.character(names), pats)\n)\nfilt.combined@meta.data\nIdents(object = filt.combined) <- \"samp.ident.recode\""
        },
        {
          "cell": 34,
          "cell_type": "code",
          "source": "options(repr.plot.width = 7, repr.plot.height = 5)\nfilt.combined <- subset(x = filt.combined, subset = orig.ident != \"gs002_sarc_scseq\")\ncols = list('#00b6e0','#ff6948','#ff6948','#ff6948','#ff6948','#ff6948','#ff6948','#ff6948','#ff6948')\nVlnPlot(filt.combined, features = c(\"nFeature_RNA\"), pt.size = 0.0, group.by = \"samp.ident.recode\", cols= cols) + \n        NoLegend() + ggtitle(\"Genes Expressed By Cell\")  +  \n     theme(axis.text.x = element_text(angle = 0, hjust=0.5)) +  geom_boxplot(width=0.1, fill=\"white\")"
