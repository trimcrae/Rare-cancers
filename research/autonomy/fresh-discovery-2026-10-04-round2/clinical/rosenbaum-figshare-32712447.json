e": "Oleg", "last_name": "Baranov", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-2710-012X"}, {"id": 24229134, "full_name": "Konstantin Chernyshov", "first_name": "Konstantin", "last_name": "Chernyshov", "is_active": false, "url_name": "_", "orcid_id": "0009-0006-5142-4067"}, {"id": 15031316, "full_name": "Nikita Kotlov", "first_name": "Nikita", "last_name": "Kotlov", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-6393-7357"}, {"id": 16014155, "full_name": "Ajay Subramanian", "first_name": "Ajay", "last_name": "Subramanian", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-7892-886X"}, {"id": 15028412, "full_name": "Everett J. Moding", "first_name": "Everett J.", "last_name": "Moding", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-7913-5351"}, {"id": 15313438, "full_name": "Li-Xuan Qin", "first_name": "Li-Xuan", "last_name": "Qin", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-9367-3807"}, {"id": 15025695, "full_name": "Phillip Wong", "first_name": "Phillip", "last_name": "Wong", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-6360-849X"}, {"id": 15017801, "full_name": "William D. Tap", "first_name": "William D.", "last_name": "Tap", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-7779-2796"}, {"id": 15044025, "full_name": "Cristina R. Antonescu", "first_name": "Cristina R.", "last_name": "Antonescu", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-9717-8205"}, {"id": 16547624, "full_name": "Katherine S. Panageas", "first_name": "Katherine S.", "last_name": "Panageas", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-6591-604X"}, {"id": 9729933, "full_name": "Ronglai Shen", "first_name": "Ronglai", "last_name": "Shen", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-9694-584X"}, {"id": 19771114, "full_name": "Sandra P. D\u2019Angelo", "first_name": "Sandra P.", "last_name": "D\u2019Angelo", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-3736-3783"}], "custom_fields": [{"name": "ARTICLE ABSTRACT", "value": "Immune checkpoint blockade (ICB) benefits only a subset of patients with sarcoma. Biomarkers of response and resistance are needed to help guide patient selection.\nWe analyzed peripheral blood and tumor samples from patients with sarcoma treated in five ICB-based clinical trials. Baseline peripheral blood mononuclear cells (PBMC) underwent 11-color flow cytometry to define T-cell immunotypes. Baseline tumor tissue underwent RNA sequencing (RNA-seq) to classify tumors into four tumor microenvironment (TME) subtypes using consensus clustering of 29 functional gene expression signatures. Associations between immune features and clinical outcomes were assessed. A deep learning model was applied to baseline hematoxylin and eosin (H&E) slides to detect and quantify lymphoid aggregates in patients with available RNA-seq.\nAmong 178 patients with PBMC available for analysis, a proliferative (PRO) circulating T-cell immunotype was associated with poorer overall survival (OS) than lymphocyte-activation gene 3 (LAG)\u2212 or LAG+ immunotypes. RNA-seq from 67 tumors identified an immune-enriched/nonfibrotic TME subtype associated with a higher response rate, longer progression-free survival, and longer OS compared with immune-enriched/fibrotic, immune-depleted, and fibrotic subtypes. Automated analysis of 48 baseline H&E slides identified lymphoid aggregates in five tumors; four were classified as immune-enriched and two of these responded to ICB.\nPatients with sarcoma and a PRO circulating T-cell immunotype had inferior outcomes to ICB, whereas those with an immune-enriched/nonfibrotic TME had superior outcomes. Automated analysis of H&E slides showed promise in identifying patients with an immune-enriched TME. These findings support the use of a multimodal approach to identify predictors of response to immunotherapy in sarcoma.", "settings": {"validations": {"min_length": 10, "max_length": 10000}, "placeholder": "ARTICLE ABSTRACT"}, "field_type": "textarea", "order": null, "is_mandatory": false}], "figshare_url": "https://aacr.figshare.com/articles/journal_contribution/Supplementary_Table_S3_from_Association_of_Circulating_T_Cell_and_Tumor_Microenvironment_Profiles_with_Immune_Checkpoint_Blockade_Outcomes_in_Sarcoma/32712447", "download_disabled": false, "description": "<p>Detailed histologic diagnoses according to TME subtype</p>", "funding": "Colleen K. Boylan Family", "funding_list": [{"id": 30304131, "title": "Colleen K. Boylan Family", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 30304134, "title": "Arden Norris and Mary Cecilia Witherwax Foundation", "grant_code": "", "funder_name": null, "is_user_defined": 1}, {"id": 6977159, "title": "National Cancer Institute (NCI)", "grant_code": "814047", "funder_name": "United States Department of Health and Human Services", "is_user_defined": 0, "url": "https://app.dimensions.ai/details/grant/grant.7584078"}], "version": 1, "status": "public", "size": 17672, "created_date": "2026-06-17T11:59:33Z", "modified_date": "2026-06-17T11:59:33Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 52, "name": "CC BY", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["Biomarkers", "Immunotherapy", "Sarcomas"], "keywords": ["Biomarkers", "Immunotherapy", "Sarcomas"], "categories": [{"id": 37339, "title": "Cancer", "parent_id": 0, "path": "/37339", "source_id": "", "taxonomy_id": 106}, {"id": 37357, "title": "Cancer Detection and Diagnosis", "parent_id": 0, "path": "/37357", "source_id": "", "taxonomy_id": 106}, {"id": 37363, "title": "Immuno-oncology", "parent_id": 0, "path": "/37363", "source_id": "", "taxonomy_id": 106}], "references": ["https://doi.org/10.1158/1078-0432.CCR-25-3419"], "has_linked_file": false, "citation": "Rosenbaum, Evan; Ehrich, Fiona; Yosofvand, Mohammad; Bradic, Marti